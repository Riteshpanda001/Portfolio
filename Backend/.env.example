# ============================================================
# Portfolio Backend — Environment Variables Reference
# ============================================================

# ── Active Spring Profile (dev or prod) ───────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── Server Port (Render injects $PORT automatically) ─────────
PORT=5000

# ── Database (Neon PostgreSQL for prod, H2 for dev) ─────────
# Neon format: jdbc:postgresql://<neon-hostname>/<dbname>?sslmode=require
DB_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_secure_password
DB_DRIVER=org.postgresql.Driver

# ── JWT Authentication (REQUIRED in prod, must be >= 64 bytes)
# Generate using: openssl rand -base64 64
JWT_SECRET=YOUR_64_BYTE_BASE64_OR_RAW_SECURE_RANDOM_SECRET_KEY_HERE_FOR_HS512

# ── Primary Admin Account (REQUIRED in prod, never use defaults)
ADMIN_EMAIL=riteshkumarpanda001@gmail.com
ADMIN_PASSWORD=YOUR_STRONG_UNIQUE_ADMIN_PASSWORD_HERE
ADMIN_NAME=Ritesh Kumar Panda

# ── CORS Allowed Origins (Comma-separated) ───────────────────
CORS_ALLOWED_ORIGINS=https://riteshpanda.vercel.app,http://localhost:5173

# ── File Uploads & Public Media URL ─────────────────────────
# Mount path on Render persistent disk (e.g. /var/data/uploads) or ./uploads
UPLOAD_DIR=./uploads
# Public base URL of backend (e.g. https://portfolio-backend-xxx.onrender.com)
APP_BASE_URL=https://your-backend-app.onrender.com

# ── Email / SMTP (Optional for contact notifications) ────────
MAIL_USERNAME=riteshkumarpanda001@gmail.com
MAIL_PASSWORD=Ritesh Kumar Panda001@2005
